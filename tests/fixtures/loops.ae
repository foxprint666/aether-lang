// loops.ae — Exercises for/while/break/continue

stable fn collatz(n: i64) -> i64 {
    let mut steps: i64 = 0;
    let mut x: i64 = n;
    while x != 1 {
        if x % 2 == 0 {
            x = x / 2;
        } else {
            x = x * 3 + 1;
        }
        steps = steps + 1;
    }
    steps
}

fn main() {
    // Collatz conjecture: how many steps to reach 1 from 27?
    let steps = collatz(27);
    print("Collatz(27) steps:");
    print(steps);

    // Countdown with break
    let mut i: i64 = 10;
    while i > 0 {
        if i == 5 {
            print("breaking at 5");
            break;
        }
        i = i - 1;
    }

    // Sum of squares
    let mut sum: i64 = 0;
    for k in range(1, 6) {
        sum = sum + k * k;
    }
    print("Sum of squares 1..5 =");
    print(sum);
}
