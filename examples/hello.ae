// hello.ae — The first Aether program
// Run with: ae run examples/hello.ae

// A stable function: compiler ERRORS if return type is not monomorphic
stable fn add(x: i64, y: i64) -> i64 {
    x + y
}

// String greeting — note auto type inference on `msg`
fn greet(name: str) -> str {
    "Hello, " + name + "!"
}

// Fibonacci — recursive, stable
stable fn fib(n: i64) -> i64 {
    if n <= 1 {
        return n;
    }
    fib(n - 1) + fib(n - 2)
}

// Sum via a for loop
stable fn sum_range(limit: i64) -> i64 {
    let mut total: i64 = 0;
    for i in range(0, limit) {
        total = total + i;
    }
    total
}

fn main() {
    // Basic output
    let msg = greet("Aether");
    print(msg);

    // Arithmetic
    let result = add(40, 2);
    print(result);

    // Fibonacci sequence
    print("Fibonacci sequence:");
    for i in range(0, 10) {
        print(fib(i));
    }

    // Sum 1..100
    let s = sum_range(101);
    print("Sum 0..100 =");
    print(s);

    // Boolean logic
    let x: i64 = 7;
    let even = x % 2 == 0;
    if even {
        print("x is even");
    } else {
        print("x is odd");
    }

    // Assertion (does not panic — 42 == 42)
    assert(add(20, 22) == 42);
    print("All assertions passed.");
}
