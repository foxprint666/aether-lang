GEMINI_API_KEY=paste_your_gemini_key_here
AETHER_GEMINI_MODEL=gemini-3.5-flash
# Retries are for transient 429/5xx responses. Daily quota exhaustion fails fast.
AETHER_GEMINI_RETRIES=2
AETHER_GEMINI_RETRY_SLEEP_CAP=30

# Optional cost estimates per 1M tokens. Leave blank if unknown.
# AETHER_GEMINI_COST_PER_1M_INPUT=
# AETHER_GEMINI_COST_PER_1M_OUTPUT=

OPENROUTER_API_KEY=paste_your_openrouter_key_here
# Prefer a pinned :free model for reproducible benchmark evidence.
# Use openrouter/free only for broad smoke checks where model routing variance is acceptable.
AETHER_OPENROUTER_MODEL=openrouter/free
AETHER_OPENROUTER_RETRIES=2
AETHER_OPENROUTER_RETRY_SLEEP_CAP=30
# Optional OpenRouter attribution headers.
# AETHER_OPENROUTER_REFERER=
# AETHER_OPENROUTER_TITLE=Aether Benchmark

# Optional cost estimates per 1M tokens. Leave blank for free models or unknown pricing.
# AETHER_OPENROUTER_COST_PER_1M_INPUT=
# AETHER_OPENROUTER_COST_PER_1M_OUTPUT=
