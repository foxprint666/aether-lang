{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether-lang/benchmark-result/v0.1.0",
  "title": "Aether Benchmark Result Record",
  "type": "object",
  "required": [
    "experiment_id",
    "timestamp",
    "commit_sha",
    "task_id",
    "repository",
    "language",
    "agent",
    "model",
    "configuration",
    "patch_generated",
    "patch_size",
    "input_tokens",
    "output_tokens",
    "tool_calls",
    "agent_attempts",
    "agent_latency_ms",
    "agent_cost_usd",
    "execution_time_ms",
    "validation_time_ms",
    "tests_passed",
    "tests_failed",
    "syntax_error",
    "runtime_error",
    "validation_failed",
    "rollback_triggered",
    "rollback_success",
    "task_success",
    "repository_corrupted",
    "error_type",
    "provider_error_type",
    "provider_status_code",
    "provider_retryable",
    "provider_quota_exhausted"
  ],
  "properties": {
    "experiment_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "commit_sha": { "type": ["string", "null"] },
    "task_id": { "type": "string" },
    "repository": { "type": "string" },
    "language": { "type": "string" },
    "agent": { "type": "string" },
    "model": { "type": ["string", "null"] },
    "category": { "type": ["string", "null"] },
    "failure_type": { "type": ["string", "null"] },
    "failure_detected": { "type": "boolean" },
    "configuration": { "type": "object" },
    "patch_generated": { "type": "boolean" },
    "patch_size": { "type": ["integer", "null"], "minimum": 0 },
    "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "estimated_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "estimated_output_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "estimated_traditional_output_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "token_estimator": { "type": ["string", "null"] },
    "hybrid_selected_mode": { "type": ["string", "null"] },
    "hybrid_reason": { "type": ["string", "null"] },
    "hybrid_token_savings_pct": { "type": ["number", "null"] },
    "tool_calls": { "type": ["integer", "null"], "minimum": 0 },
    "agent_attempts": { "type": ["integer", "null"], "minimum": 0 },
    "agent_latency_ms": { "type": ["number", "null"], "minimum": 0 },
    "agent_cost_usd": { "type": ["number", "null"], "minimum": 0 },
    "execution_time_ms": { "type": ["number", "null"], "minimum": 0 },
    "validation_time_ms": { "type": ["number", "null"], "minimum": 0 },
    "tests_passed": { "type": ["integer", "null"], "minimum": 0 },
    "tests_failed": { "type": ["integer", "null"], "minimum": 0 },
    "syntax_error": { "type": "boolean" },
    "runtime_error": { "type": "boolean" },
    "validation_failed": { "type": "boolean" },
    "rollback_triggered": { "type": "boolean" },
    "rollback_success": { "type": ["boolean", "null"] },
    "task_success": { "type": "boolean" },
    "repository_corrupted": { "type": "boolean" },
    "error_type": { "type": ["string", "null"] },
    "provider_error_type": { "type": ["string", "null"] },
    "provider_status_code": { "type": ["integer", "null"] },
    "provider_retryable": { "type": ["boolean", "null"] },
    "provider_quota_exhausted": { "type": "boolean" }
  },
  "additionalProperties": true
}
