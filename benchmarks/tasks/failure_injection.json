{
  "suite": "failure-injection",
  "version": "0.2.0",
  "description": "Controlled failure-injection tasks. These cases measure observed detection and rollback behavior for known failure classes; they are not a comprehensive safety proof.",
  "tasks": [
    {
      "task_id": "py-fi-control-syntax-error",
      "language": "python",
      "repository": "synthetic-temp-project",
      "fixture": "basic_math",
      "category": "failure_injection",
      "failure_type": "syntax_error",
      "description": "Direct control edit introduces invalid Python syntax.",
      "test_command": "python -m py_compile app.py; python app.py",
      "timeout_ms": 10000,
      "supported_modes": [
        "control"
      ],
      "expected_success": false,
      "expected_error_type": "syntax_error",
      "expected_rollback": false,
      "expected_failure_detected": true,
      "patch": {
        "action": "modify_function",
        "target": {
          "file": "app.py",
          "symbol": "total",
          "symbol_type": "function"
        },
        "changes": {
          "operation": "replace_body",
          "payload": "return (1 +\n"
        }
      }
    },
    {
      "task_id": "py-fi-aether-syntax-payload",
      "language": "python",
      "repository": "synthetic-temp-project",
      "fixture": "basic_math",
      "category": "failure_injection",
      "failure_type": "syntax_error",
      "description": "Aether receives a schema-valid Python patch with syntactically invalid payload.",
      "test_command": "python -m py_compile app.py; python app.py",
      "timeout_ms": 10000,
      "supported_modes": [
        "aether"
      ],
      "expected_success": false,
      "expected_error_type": "aether_apply_failed",
      "expected_rollback": true,
      "expected_failure_detected": true,
      "patch": {
        "action": "modify_function",
        "target": {
          "file": "app.py",
          "symbol": "total",
