        "action": "replace_block",
        "target": {"file": "index.js"},
        "changes": {
          "operation": "context_replace",
          "context_before": "\tpeek() {\n",
          "context_after": "\n\t}\n\n\tclear()",
          "payload": "\t\tconst head = this.#head;\n\t\tif (!head) {\n\t\t\treturn;\n\t\t}\n\n\t\treturn head.value;"
        }
      }
