      "fixture": "repo:git:pallets-markupsafe",
      "source_file": "src/markupsafe/_native.py",
      "category": "external_repository",
      "description": "Add a standard-library import to MarkupSafe while preserving escape behavior.",
      "test_command": "python -c \"import sys; sys.path.insert(0, 'src'); from markupsafe._native import _escape_inner; assert _escape_inner('<a&') == '&lt;a&amp;'\"",
      "verification_level": "behavior",
      "timeout_ms": 30000,
      "supported_modes": ["control", "state", "aether"],
      "expected_success": true,
      "expected_stdout": null,
      "expected_content": ["import json"],
      "expected_absent_content": [],
      "patch": {
        "action": "update_import",
        "target": {"file": "src/markupsafe/_native.py"},
        "changes": {"operation": "add_import", "imports": ["import json"]}
      }
    },
    {
      "task_id": "external-markupsafe-modify-function",
      "language": "python",
      "repository": "pallets-markupsafe",
