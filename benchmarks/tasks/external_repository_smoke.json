      "task_id": "external-escape-regexp-modify-function",
      "language": "javascript",
      "repository": "sindresorhus-escape-string-regexp",
      "repository_manifest": "benchmarks/repositories/escape_string_regexp_pinned.json",
      "fixture": "repo:git:sindresorhus-escape-string-regexp",
      "source_file": "index.js",
      "category": "external_repository",
      "description": "Rewrite escape-string-regexp's exported function body while preserving behavior.",
      "test_command": "node --input-type=module -e \"import escapeStringRegexp from './index.js'; if (escapeStringRegexp('.').length !== 2) process.exit(1)\"",
      "verification_level": "behavior",
      "timeout_ms": 30000,
      "supported_modes": ["control", "state", "aether"],
      "expected_success": true,
      "expected_stdout": null,
      "expected_content": ["const escaped = string", "return escaped;"],
      "expected_absent_content": ["return string\n\t\t.replace"],
      "patch": {
        "action": "modify_function",
        "target": {"file": "index.js", "symbol": "escapeStringRegexp", "symbol_type": "function"},
        "changes": {
          "operation": "replace_body",
          "payload": "if (typeof string !== 'string') {\n\tthrow new TypeError('Expected a string');\n}\nconst escaped = string\n\t.replace(/[|\\\\{}()[\\]^$+*?.]/g, '\\\\$&')\n\t.replace(/-/g, '\\\\x2d');\nreturn escaped;"
        }
      }
