      "fixture": "repo:git:pallets-markupsafe",
      "source_file": "src/markupsafe/_native.py",
      "category": "external_repository",
      "description": "Rewrite MarkupSafe's native escape function body without changing behavior.",
      "test_command": "python -c \"import sys; sys.path.insert(0, 'src'); from markupsafe._native import _escape_inner; assert _escape_inner('<a&') == '&lt;a&amp;'\"",
      "verification_level": "behavior",
      "timeout_ms": 30000,
      "supported_modes": ["control", "state", "aether"],
      "expected_success": true,
      "expected_stdout": null,
      "expected_content": ["escaped = (", "return escaped"],
      "expected_absent_content": ["def _escape_inner(s: str, /) -> str:\n    return ("],
      "patch": {
        "action": "modify_function",
        "target": {"file": "src/markupsafe/_native.py", "symbol": "_escape_inner", "symbol_type": "function"},
        "changes": {
          "operation": "replace_body",
          "payload": "escaped = (\n    s.replace(\"&\", \"&amp;\")\n    .replace(\">\", \"&gt;\")\n    .replace(\"<\", \"&lt;\")\n    .replace(\"'\", \"&#39;\")\n    .replace('\\\"', \"&#34;\")\n)\nreturn escaped"
        }
      }
    },
