        "aether"
      ],
      "expected_success": true,
      "expected_stdout": "value=3",
      "expected_content": [
        "import sys"
      ],
      "expected_absent_content": [
        "import os"
      ],
      "patch": {
        "action": "update_import",
        "target": {
          "file": "app.py"
        },
        "changes": {
          "operation": "remove_import",
          "imports": [
            "import os"
          ]
        }
      }
    },
    {
      "task_id": "py-replace-block",
      "language": "python",
      "repository": "synthetic-temp-project",
      "fixture": "block",
      "category": "valid_transformation",
      "description": "Replace a context-selected block and verify behavior.",
      "test_command": "python -m py_compile app.py; python app.py",
      "timeout_ms": 10000,
      "supported_modes": [
        "control",
        "state",
        "aether"
      ],
      "expected_success": true,
      "expected_stdout": "value=42",
      "expected_content": [
        "value = 42"
      ],
      "expected_absent_content": [
        "value = 2"
      ],
      "patch": {
        "action": "replace_block",
        "target": {
          "file": "app.py"
        },
        "changes": {
          "operation": "context_replace",
          "context_before": "    value = 1\n",
          "context_after": "    return value\n",
          "payload": "    value = 42"
        }
      }
    },
