{
  "suite": "correctness",
  "version": "0.2.0",
  "description": "Deterministic correctness tasks for the benchmark runner. These tasks exercise implemented Python patch actions and validation behavior.",
  "tasks": [
    {
      "task_id": "py-modify-function",
      "language": "python",
      "repository": "synthetic-temp-project",
      "fixture": "basic_math",
      "category": "valid_transformation",
      "description": "Modify a Python function body and verify syntax plus behavior.",
      "test_command": "python -m py_compile app.py; python app.py",
      "timeout_ms": 10000,
      "supported_modes": [
        "control",
        "state",
        "aether"
      ],
      "expected_success": true,
      "expected_stdout": "total=42",
      "expected_content": [
        "def total()",
        "return add(20, 22)"
      ],
      "expected_absent_content": [
        "return 0"
      ],
      "patch": {
        "action": "modify_function",
        "target": {
          "file": "app.py",
          "symbol": "total",
          "symbol_type": "function"
        },
        "changes": {
          "operation": "replace_body",
          "payload": "return add(20, 22)\n"
        }
      }
    },
    {
      "task_id": "py-add-import",
      "language": "python",
      "repository": "synthetic-temp-project",
      "fixture": "imports",
      "category": "valid_transformation",
      "description": "Add Python imports without breaking existing behavior.",
      "test_command": "python -m py_compile app.py; python app.py",
      "timeout_ms": 10000,
      "supported_modes": [
        "control",
        "state",
        "aether"
      ],
      "expected_success": true,
      "expected_stdout": "name=ADA",
      "expected_content": [
        "from pathlib import Path",
        "import json"
      ],
      "expected_absent_content": [],
      "patch": {
        "action": "update_import",
        "target": {
          "file": "app.py"
        },
        "changes": {
          "operation": "add_import",
          "imports": [
            "import json",
            "from pathlib import Path"
          ]
        }
      }
    },
    {
      "task_id": "py-remove-import",
      "language": "python",
      "repository": "synthetic-temp-project",
      "fixture": "unused_import",
      "category": "valid_transformation",
      "description": "Remove an unused Python import while preserving behavior.",
      "test_command": "python -m py_compile app.py; python app.py",
      "timeout_ms": 10000,
      "supported_modes": [
        "control",
